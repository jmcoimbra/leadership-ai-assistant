#!/bin/bash
# Example: run an autonomous agent against this brain on a schedule.
# Copy to run_<task>.sh and customize. Wire to launchd / cron / GitHub Actions.
#
# Requires: claude CLI (https://docs.anthropic.com/en/docs/agents-and-tools/claude-code)

set -e
BRAIN_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$BRAIN_DIR/.context/logs"
mkdir -p "$LOG_DIR"
cd "$BRAIN_DIR"

LOG="$LOG_DIR/$(basename "$0" .sh).log"
echo "--- Run: $(date '+%Y-%m-%d %H:%M:%S %z') ---" >> "$LOG"

# Pull latest brain state (if you push to a remote)
# git pull --ff-only origin main >> "$LOG" 2>&1 || echo "git pull failed, continuing with local state" >> "$LOG"

# Adapt this prompt and allowedTools to your task.
# Example: run a daily morning scan that drafts a status message.
claude -p \
  --max-budget-usd 0.50 \
  --allowedTools "Read,Write,Edit,Glob,Grep" \
  "Read AGENTS.md and 07_operating_rhythms/weekly_review.md. Run the Monday weekly review checklist against current brain state. Draft a summary." \
  >> "$LOG" 2>&1
